{
  "name": "eloscrm-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:push:test": "DOTENV_CONFIG_PATH=.env.test prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "audit:purge": "tsx scripts/purge-audit.ts",
    "audit:backfill-labels": "tsx scripts/backfill-audit-labels.ts",
    "backfill:lead-names": "tsx scripts/backfill-lead-names.ts",
    "backfill:shared-contacts": "tsx scripts/backfill-shared-contacts.ts",
    "auth:generate": "pnpm dlx @better-auth/cli@1.4.21 generate --output prisma/schema.prisma -y"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1096.0",
    "@aws-sdk/lib-storage": "^3.1101.0",
    "@aws-sdk/s3-request-presigner": "^3.1096.0",
    "@fastify/autoload": "^6.4.0",
    "@fastify/cors": "^11.3.0",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "@t3-oss/env-core": "^0.13.11",
    "axios": "^1.19.0",
    "better-auth": "^1.6.24",
    "bullmq": "^6.0.6",
    "dotenv": "^17.4.2",
    "fastify": "^5.10.0",
    "fastify-plugin": "^6.0.0",
    "ioredis": "^6.0.0",
    "resend": "^6.18.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "oxlint": "^1.75.0",
    "prisma": "^7.9.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
