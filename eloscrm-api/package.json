{
  "name": "eloscrm-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:push:test": "DOTENV_CONFIG_PATH=.env.test prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "audit:purge": "tsx scripts/purge-audit.ts",
    "audit:backfill-labels": "tsx scripts/backfill-audit-labels.ts",
    "backfill:lead-names": "tsx scripts/backfill-lead-names.ts",
    "backfill:message-kinds": "tsx scripts/backfill-message-kinds.ts",
    "meta:sync": "tsx scripts/meta-sync.ts",
    "auth:generate": "pnpm dlx auth@1.7.2 generate --output prisma/schema.prisma -y"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1125.0",
    "@aws-sdk/lib-storage": "^3.1125.0",
    "@aws-sdk/s3-request-presigner": "^3.1125.0",
    "@fastify/autoload": "^6.5.0",
    "@fastify/cors": "^11.3.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@t3-oss/env-core": "^0.13.11",
    "axios": "^1.20.0",
    "better-auth": "1.7.2",
    "bullmq": "^6.3.4",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.1",
    "fastify-plugin": "^6.0.0",
    "ioredis": "^6.0.0",
    "resend": "^6.25.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "oxlint": "^1.81.0",
    "prisma": "^7.10.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
