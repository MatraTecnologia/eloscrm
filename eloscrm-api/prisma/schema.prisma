
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String       @id
  name          String
  email         String
  emailVerified Boolean      @default(false)
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  sessions      Session[]
  accounts      Account[]
  members       Member[]
  invitations   Invitation[]

  uazapiInstanceLogs UazapiInstanceLog[]
  whatsappMessages   WhatsappMessage[]

  @@unique([email])
  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Organization {
  id          String       @id @default(cuid())
  name        String
  slug        String
  logo        String?
  createdAt   DateTime     @default(now())
  metadata    String?
  members     Member[]
  invitations Invitation[]
  clients     Client[]
  properties  Property[]
  pipelines   Pipeline[]
  stages      Stage[]
  deals       Deal[]
  activities  Activity[]
  auditEvents AuditEvent[]
  comments    Comment[]
  attachments Attachment[]

  // uma imobiliária conecta no máximo um número de WhatsApp
  uazapiInstance UazapiInstance?
  leadAutomation LeadAutomation?
  conversations  Conversation[]
  whatsappMessages WhatsappMessage[]

  @@unique([slug])
  @@map("organization")
}

model Member {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

enum ClientSource {
  SITE
  INSTAGRAM
  INDICACAO
  WHATSAPP
  OUTROS
}


enum ActivityType {
  CALL
  VISIT
  PROPOSAL
  NOTE
}

enum PropertyStatus {
  DISPONIVEL
  RESERVADO
  VENDIDO
  INATIVO
}

/// Discriminador de `AuditEvent`, `Comment` e `Attachment`. Comentário e anexo só existem para as quatro
/// primeiras — ver ATTACHABLE_ENTITIES/COMMENTABLE_ENTITIES, que é o subconjunto que os schemas validam.
enum AuditEntity {
  CLIENT
  DEAL
  PROPERTY
  ACTIVITY
  PIPELINE
  STAGE
  COMMENT
  ATTACHMENT
  CONVERSATION
  WHATSAPP_MESSAGE
  WHATSAPP_INSTANCE
  LEAD_AUTOMATION
  MEMBER
  INVITATION
  ORGANIZATION
  SESSION
}

enum AuditAction {
  CREATED
  UPDATED
  DELETED
  STAGE_CHANGED
  OWNER_CHANGED
  TRANSFERRED
  REORDERED
  NURTURED
  REACTIVATED
  ARCHIVED
  UNARCHIVED
  LINKED
  UNLINKED
  UPLOADED
  DOWNLOADED
  MESSAGE_SENT
  MESSAGE_DELETED
  CONNECTED
  DISCONNECTED
  RESET
  SYNCED
  WEBHOOK_RECONCILED
  TEST_MESSAGE_SENT
  SIGNED_IN
  SIGNED_OUT
  MEMBER_ADDED
  MEMBER_REMOVED
  ROLE_CHANGED
  INVITED
  INVITE_REVOKED
  EXPORTED
  PURGED
}

/// Quem originou a ação. `WEBHOOK` é a uazapi entregando evento; `SYSTEM`, o que roda sem request
/// (purga por retenção). Espelha UazapiInstanceLogSource, em maiúsculas como os outros enums daqui.
enum AuditSource {
  USER
  AUTOMATION
  WEBHOOK
  SYSTEM
}

enum AttachmentStatus {
  PENDING
  READY
}

enum LeadTemperature {
  FRIO
  MORNO
  QUENTE
}

enum ClientStatus {
  ACTIVE
  NURTURING
}

enum NurtureReason {
  SEM_ORCAMENTO
  ADIADO
  SEM_RESPOSTA
  COMPROU_COM_OUTRO
  SO_PESQUISANDO
  OUTRO
}

model Client {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ownerId        String?
  name           String
  email          String?
  phone          String?
  // DDD + últimos 8 dígitos de `phone`, derivado em src/lib/phone.ts. Existe porque o telefone é
  // guardado com máscara e 11 dígitos, e o WhatsApp entrega 10 (o nono dígito) — sem esta chave,
  // conversa e lead nunca casam. Escrita só pelo repo, junto de `phone`.
  phoneKey       String?
  source         ClientSource @default(OUTROS)
  notes          String?
  // notes segue sendo o recado curto; description é o texto do perfil do lead
  description  String?
  tags         String[]
  temperature  LeadTemperature @default(MORNO)
  interestType String?
  budgetMin    Decimal?
  budgetMax    Decimal?
  // estado de workflow, ortogonal a `temperature`: sai da lista de trabalho e volta na data marcada
  status        ClientStatus   @default(ACTIVE)
  nurtureReason NurtureReason?
  nurtureNote   String?
  // null = sem data definida, que é um estado real: o corretor nem sempre sabe quando voltar
  nurtureUntil  DateTime?
  nurturedAt    DateTime?
  deals          Deal[]
  activities     Activity[]
  conversations  Conversation[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([organizationId, status, nurtureUntil])
  @@index([organizationId, phoneKey])
}

model Property {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String
  type           String?
  address        String?
  price          Decimal?
  bedrooms       Int?
  area           Float?
  status         PropertyStatus @default(DISPONIVEL)
  photos         String[]
  deals          Deal[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([organizationId])
}

model Pipeline {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  isDefault      Boolean      @default(false)
  position       Int          @default(0)
  stages         Stage[]
  deals          Deal[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Stage {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pipelineId     String
  pipeline       Pipeline     @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  name           String
  position       Int          @default(0)
  color          String?
  isWon          Boolean      @default(false)
  isLost         Boolean      @default(false)
  deals          Deal[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([pipelineId])
}

model Deal {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId       String
  client         Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  propertyId     String?
  property       Property?    @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  pipelineId     String
  pipeline       Pipeline     @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  stageId        String
  stage          Stage        @relation(fields: [stageId], references: [id], onDelete: Restrict)
  ownerId        String?
  title          String
  value          Decimal?
  lostReason     String?
  activities     Activity[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, pipelineId])
  @@index([stageId])
}

model Activity {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId       String?
  client         Client?      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  dealId         String?
  deal           Deal?        @relation(fields: [dealId], references: [id], onDelete: Cascade)
  type           ActivityType
  description    String
  dueAt          DateTime?
  doneAt         DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([organizationId, dueAt])
}

model AuditEvent {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Desnormalização, não sobrevivência: a relação é Cascade, então excluir a imobiliária leva o log
  /// dela. Existe para a busca e o CSV não precisarem de join — e por isso não pode ser cacheado, que
  /// renomear a organização é caso real e auditado.
  organizationName String?

  entityType AuditEntity
  entityId   String
  /// Nome que o item tinha no momento do fato. É o que mantém o evento legível depois de o dado ser
  /// apagado: sem isto a tela mostra cuid, porque não há mais linha para resolver o nome.
  entityLabel String?

  action AuditAction
  source AuditSource @default(USER)

  // snapshot: o histórico mostra o nome que a pessoa tinha na hora do fato e sobrevive a ela sair da org
  actorId    String?
  actorName  String?
  actorEmail String?

  // { campo: { from, to } }, só o que mudou
  changes Json?
  /// A que o item pertencia, desnormalizado (lead, funil, estágio, conversa) — para a tela dizer "no
  /// funil Vendas" sem depender de uma linha que pode não existir mais.
  context Json?
  /// Estado no momento do fato, por allowlist de campos (src/lib/audit-snapshot.ts). Telefone e e-mail
  /// entram mascarados e conteúdo de conversa não entra: isto sobrevive à exclusão pedida pelo titular,
  /// e quem limita no tempo é AUDIT_RETENTION_DAYS.
  snapshot Json?

  ip        String?
  userAgent String?
  /// request.id do Fastify: agrupa os eventos nascidos da mesma chamada (ex.: transferência em lote)
  requestId String?

  createdAt DateTime @default(now())

  @@index([organizationId, entityType, entityId, createdAt])
  @@index([organizationId, createdAt])
  @@index([organizationId, actorId, createdAt])
  // a purga por retenção varre por data, sem filtro de organização
  @@index([createdAt])
}

model Comment {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // mesmo par do AuditEvent, e pelo mesmo motivo: sem FK, o comentário não força uma coluna por tipo
  entityType     AuditEntity
  entityId       String
  // snapshot: o mural mostra quem era a pessoa na hora, e sobrevive a ela sair da imobiliária
  authorId       String
  authorName     String
  body           String
  editedAt       DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, entityType, entityId, createdAt])
}

model Attachment {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // mesmo par do AuditEvent e do Comment, e pelo mesmo motivo: sem FK por tipo de entidade
  entityType     AuditEntity
  entityId       String
  // chave no bucket privado: org/<orgId>/<entityType>/<entityId>/<cuid>-<slug>
  key            String           @unique
  filename       String
  contentType    String
  size           Int
  // PENDING até o confirm achar o objeto no bucket; a listagem só mostra READY
  status         AttachmentStatus @default(PENDING)
  uploadedById   String
  uploadedByName String
  createdAt      DateTime         @default(now())

  @@index([organizationId, entityType, entityId, createdAt])
}

// hibernated entrou na uazapi v2.1.1: sessão pausada com as credenciais preservadas. Sem esse valor
// aqui, parseStatus devolve null e o status local congela no anterior — a tela mostraria "conectado"
// para um número que parou de atender.
enum UazapiInstanceStatus {
  disconnected
  connecting
  connected
  hibernated
}

enum UazapiInstanceLogEvent {
  created
  connect_requested
  qr_generated
  paircode_generated
  connected
  disconnected
  status_changed
  reset
  synced
  name_updated
  webhook_configured
  test_message_sent
  remote_deleted
  deleted
  error
}

enum UazapiInstanceLogSource {
  manual
  webhook
  sync
  system
}

model UazapiInstance {
  id String @id @default(cuid())

  // @unique é a regra de negócio no banco: uma instância por imobiliária. É também o que permite às
  // rotas serem /v1/whatsapp/instance no singular, sem id na URL para adulterar.
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  remoteId String @unique
  name     String

  // token da instância cifrado em AES-256-GCM; nunca sai da API em claro
  tokenEnc      String
  tokenLast4    String?
  tokenHash     String  @unique
  // segredo do último segmento da URL do webhook desta instância
  webhookSecret String  @unique

  status       UazapiInstanceStatus @default(disconnected)
  lastStatusAt DateTime?
  qrcode       String?
  paircode     String?

  profileName   String?
  profilePicUrl String?
  isBusiness    Boolean?
  // o typo é da uazapi, preservado para casar com o payload
  plataform     String?
  ownerJid      String?
  systemName    String?

  lastDisconnectAt     DateTime?
  lastDisconnectReason String?
  // preenchido quando a instância some do provedor; a partir daí só resta remover e recriar
  remoteDeletedAt      DateTime?

  logs          UazapiInstanceLog[]
  conversations Conversation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum WhatsappDirection {
  inbound
  outbound
}

// Espelha `mediaType` da uazapi, não `type`: é `mediaType` que separa gif de vídeo e nota de voz de
// áudio comum, e as duas distinções mudam como a bolha é renderizada.
enum WhatsappMessageType {
  text
  image
  video
  gif
  audio
  ptt
  document
  sticker
  location
  contact
  reaction
  poll
  system
  unsupported
}

enum WhatsappMessageStatus {
  pending
  sent
  delivered
  read
  failed
}

// A mensagem existe antes do arquivo estar no R2: a uazapi só guarda a mídia por 2 dias, então ela
// é copiada em segundo plano e a bolha usa o thumbnail embutido enquanto isso.
enum WhatsappMediaStatus {
  none
  pending
  ready
  failed
}

model Conversation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  instanceId     String
  instance       UazapiInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  // 554391834229@s.whatsapp.net
  chatid   String
  phone    String?
  // casa com Client.phoneKey; ver src/lib/phone.ts
  phoneKey String?
  // identificador opaco do WhatsApp: sobrevive à troca de número, mas não revela o telefone
  lid      String?
  isGroup  Boolean @default(false)

  waName      String?
  contactName String?
  photoUrl    String?

  // opcional de propósito: a conversa chega antes de existir lead, e é o corretor quem decide criar
  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  lastMessageAt   DateTime?
  lastMessageText String?
  unreadCount     Int       @default(0)
  archivedAt      DateTime?

  messages  WhatsappMessage[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([instanceId, chatid])
  @@index([organizationId, lastMessageAt])
  @@index([organizationId, phoneKey])
}

model WhatsappMessage {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  // `message.id` da uazapi (owner:messageid) — chave de idempotência do webhook
  providerId String
  // `message.messageid` puro: é por ele que messages_update endereça as mensagens em lote
  providerMessageId String?

  direction WhatsappDirection
  type      WhatsappMessageType
  // messageType bruto (ImageMessage, Conversation…): guardado para diagnóstico, não para ramificar
  rawType   String?
  status    WhatsappMessageStatus @default(sent)

  text       String?
  quotedId   String?
  reactionTo String?
  sentByApi  Boolean @default(false)
  senderLid  String?
  senderName String?

  // "apagar para todos" no WhatsApp. O conteúdo continua gravado — quem some com ele é a API, que
  // não o serializa; a linha fica para a thread não abrir buraco e para o registro não depender de
  // um clique no celular do lead.
  deletedAt DateTime?

  mediaStatus   WhatsappMediaStatus @default(none)
  mediaKey      String?
  mediaMime     String?
  mediaSize     Int?
  mediaFilename String?
  mediaDuration Int?
  mediaWidth    Int?
  mediaHeight   Int?
  // JPEGThumbnail em base64, direto do webhook: preview instantâneo, sem chamada externa
  // Enquete: `{ name, options[], multiple }`. Os votos chegam em evento separado e não são
  // ingeridos — o cartão mostra a pergunta e as opções, sem contagem.
  poll          Json?
  // Localização compartilhada: `{ lat, lng, name?, address?, url? }`. O mapa estático que vem no
  // mesmo envelope é lido como `mediaThumb`, junto com o de foto e vídeo.
  location      Json?
  // Contatos de uma mensagem de contato compartilhado, já traduzidos do vCard
  // (`[{ name, phones[], business }]`). Guardar o parse, e não o cartão cru, mantém fora do banco o
  // `X-WA-BIZ-DESCRIPTION` — texto de propaganda com emoji e quebras de linha que ninguém exibe.
  contacts      Json?
  mediaThumb    String?
  mediaWaveform String?
  // ponte enquanto o upload para o R2 não terminou; a uazapi expira em ~2 dias
  mediaTempUrl       String?
  mediaTempExpiresAt DateTime?
  mediaError         String?

  // quem enviou pelo CRM; nulo em mensagem recebida ou enviada pelo celular
  sentById String?
  sentBy   User?  @relation(fields: [sentById], references: [id], onDelete: SetNull)

  /// Fixar é nativo do WhatsApp e tem validade (1, 7 ou 30 dias). `pinnedUntil` guarda o fim para a
  /// barra do topo parar de mostrar sozinha — o provedor não avisa quando expira.
  pinnedAt    DateTime?
  pinnedUntil DateTime?

  /// Favoritar **não existe na API da uazapi**: é marca do CRM, compartilhada pela imobiliária, e
  /// não aparece nas favoritas do WhatsApp de ninguém. `favoritedById` é para a tela dizer de quem
  /// partiu, já que a marca é da equipe.
  favoritedAt   DateTime?
  favoritedById String?

  reactions WhatsappReaction[]

  sentAt    DateTime
  createdAt DateTime @default(now())

  @@unique([conversationId, providerId])
  @@index([conversationId, sentAt])
  @@index([organizationId, providerMessageId])
  // a barra de fixadas e o filtro de favoritas leem por conversa, não a thread inteira
  @@index([conversationId, pinnedUntil])
  @@index([conversationId, favoritedAt])
}

model UazapiInstanceLog {
  id String @id @default(cuid())

  instanceId String
  instance   UazapiInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  event  UazapiInstanceLogEvent
  source UazapiInstanceLogSource

  previousStatus UazapiInstanceStatus?
  newStatus      UazapiInstanceStatus?

  actorUserId String?
  actor       User?   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  message String?
  payload Json?

  createdAt DateTime @default(now())

  @@index([instanceId, createdAt])
}

enum LeadAssignStrategy {
  // menos negócios abertos; empate resolve por lastAssignedAt
  LEAST_OPEN
}

/// Automação de entrada de leads: o que acontece sozinho quando alguém desconhecido escreve.
/// As três chaves são independentes de propósito — criar lead sem distribuir é configuração
/// legítima de quem ainda não confia na roleta.
model LeadAutomation {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  autoCreateClient Boolean @default(false)

  autoCreateDeal Boolean @default(false)
  // sem relação declarada, como Deal.ownerId: quem garante que o estágio é do funil e que ambos são
  // da organização é o service, no PUT. Funil apagado com a chave ligada não cria negócio.
  pipelineId     String?
  stageId        String?

  autoAssign Boolean            @default(false)
  strategy   LeadAssignStrategy @default(LEAST_OPEN)

  members   LeadAutomationMember[]
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt
}

/// Quem participa da roleta. A elegibilidade real é a interseção disto com `Member` no momento da
/// atribuição — `ownerId` não tem chave estrangeira, e corretor que sai da imobiliária precisa parar
/// de receber sem ninguém lembrar de limpar esta tabela.
model LeadAutomationMember {
  id           String         @id @default(cuid())
  automationId String
  automation   LeadAutomation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  userId       String
  active       Boolean        @default(true)
  // desempate enquanto as cargas são iguais — sem isto, com todos em zero, o primeiro da lista
  // receberia todos os leads até alguém acumular carga
  lastAssignedAt DateTime?

  @@unique([automationId, userId])
}

/// Reação (emoji) a uma mensagem. **Não** é uma mensagem na thread: o WhatsApp mostra a reação
/// colada na bolha do alvo, e ingerir como mensagem enche a conversa de bolhas soltas.
///
/// O provedor garante uma reação ativa por pessoa e por mensagem — trocar substitui, e emoji vazio
/// remove. Daí o @@unique.
model WhatsappReaction {
  id        String          @id @default(cuid())
  messageId String
  message   WhatsappMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  emoji String

  /// Quem reagiu. Para o que sai daqui é sempre `me`, **inclusive** quando a reação foi feita pelo
  /// celular e voltou pelo webhook com o LID da própria instância — sem colapsar os dois, a mesma
  /// pessoa criaria duas linhas. Para quem recebe, é o `sender_lid`, o que já serve a grupo sem
  /// precisar de migração depois.
  authorLid  String
  authorName String?

  reactedAt DateTime
  createdAt DateTime @default(now())

  @@unique([messageId, authorLid])
  @@index([messageId])
}
