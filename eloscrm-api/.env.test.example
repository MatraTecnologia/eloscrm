# Copie para .env.test antes de rodar `pnpm test`:
#   cp .env.test.example .env.test && pnpm db:push:test
# Banco exclusivo dos testes — a suíte trunca todas as tabelas entre arquivos.
# Nunca apontar para o banco de dev nem para um banco remoto.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/eloscrm_test?sslmode=disable
BETTER_AUTH_SECRET=test-secret-nao-usar-fora-dos-testes
BETTER_AUTH_URL=http://localhost:3333
WEB_ORIGIN=http://localhost:3000
PORT=3333

# S3 local (SeaweedFS na 8333) — os testes de anexo sobem e apagam objeto de verdade.
# Nunca apontar para o bucket de produção: a suíte escreve e apaga a cada execução.
R2_ENDPOINT=http://localhost:8333
R2_ACCESS_KEY_ID=seaweedadmin
R2_SECRET_ACCESS_KEY=seaweedadmin
R2_PRIVATE_BUCKET_NAME=eloscrm-test

# Sem chave nos testes: o mailer vira no-op silencioso e nenhuma requisição sai para o Resend.
RESEND_API_KEY=

# uazapi: a suíte mocka o client HTTP, então nenhuma requisição sai daqui. Estas envs existem só
# para as rotas passarem da checagem de "integração configurada" — os valores são fictícios.
UAZAPI_BASE_URL=http://uazapi.invalid
UAZAPI_ADMIN_TOKEN=test-admin-token
UAZAPI_TOKEN_ENCRYPTION_KEY=00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff
PUBLIC_API_URL=http://localhost:3333

# REDIS_URL fica DE FORA nos testes de propósito: sem ela o enqueue chama o processador na hora,
# o que torna a suíte determinística. Com Redis, o teste teria de esperar o worker.

# Retenção da auditoria. Os testes passam o corte explicitamente, então o valor aqui não muda
# resultado — está declarado só para o schema de env não depender do default.
AUDIT_RETENTION_DAYS=365
