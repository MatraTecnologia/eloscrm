# Copie para .env.test antes de rodar `pnpm test`:
#   cp .env.test.example .env.test && pnpm db:push:test
# Banco exclusivo dos testes — a suíte trunca todas as tabelas entre arquivos.
# Nunca apontar para o banco de dev nem para um banco remoto.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/eloscrm_test?sslmode=disable
BETTER_AUTH_SECRET=test-secret-nao-usar-fora-dos-testes
BETTER_AUTH_URL=http://localhost:3333
WEB_ORIGIN=http://localhost:3000
PORT=3333

# S3 local (SeaweedFS na 8333) — os testes de anexo sobem e apagam objeto de verdade.
# Nunca apontar para o bucket de produção: a suíte escreve e apaga a cada execução.
R2_ENDPOINT=http://localhost:8333
R2_ACCESS_KEY_ID=seaweedadmin
R2_SECRET_ACCESS_KEY=seaweedadmin
R2_PRIVATE_BUCKET_NAME=eloscrm-test

# Sem chave nos testes: o mailer vira no-op silencioso e nenhuma requisição sai para o Resend.
RESEND_API_KEY=
