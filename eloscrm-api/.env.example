# Copie para .env antes de rodar `pnpm dev`:
#   cp .env.example .env && pnpm db:push
# Os testes NÃO usam este arquivo — ver .env.test.example.
# Default: Postgres local (`docker compose up -d` na raiz do repo).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/eloscrm_dev?sslmode=disable
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3333
WEB_ORIGIN=http://localhost:3000
PORT=3333

R2_ENDPOINT=http://localhost:8333
R2_ACCESS_KEY_ID=seaweedadmin
R2_SECRET_ACCESS_KEY=seaweedadmin
R2_PRIVATE_BUCKET_NAME=eloscrm-private

# Resend (transacional). Em branco = nada é enviado; o conteúdo do e-mail sai no stdout do server.
# EMAIL_FROM precisa de domínio verificado no Resend; o default usa o remetente de teste deles.
RESEND_API_KEY=
EMAIL_FROM=elosCRM <onboarding@resend.dev>

# uazapi (WhatsApp). Em branco = integração desligada; as rotas /v1/whatsapp respondem 503.
# UAZAPI_TOKEN_ENCRYPTION_KEY: openssl rand -hex 32. Perder a chave invalida todos os tokens salvos.
# PUBLIC_API_URL: URL pública desta API, para a uazapi entregar o webhook. Em dev precisa de túnel
# (ex: cloudflared tunnel --url http://localhost:3333); sem ele, sincronize pela tela.
UAZAPI_BASE_URL=https://free.uazapi.com
UAZAPI_ADMIN_TOKEN=
UAZAPI_TOKEN_ENCRYPTION_KEY=
PUBLIC_API_URL=

# Trilha de diagnóstico da integração em JSONL: o que sai para a uazapi, o que volta e o corpo cru
# dos webhooks. Vazio = desligado. Valores de token/segredo saem redigidos, mas as chaves ficam —
# é o nome do campo que revela o formato do envelope. Ligar só enquanto investiga.
# ATENÇÃO: o corpo gravado tem telefone e nome de contato. O arquivo é dado pessoal (LGPD): não
# compartilhe em issue/chat/ticket e apague ao terminar.
# UAZAPI_DEBUG_LOG=logs/uazapi.jsonl
