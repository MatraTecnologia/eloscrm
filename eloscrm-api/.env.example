# Copie para .env antes de rodar `pnpm dev`:
#   cp .env.example .env && pnpm db:push
# Os testes NÃO usam este arquivo — ver .env.test.example.
# Default: Postgres local (`docker compose up -d` na raiz do repo).
# Para uma senha própria do Postgres: openssl rand -hex 32.
# Configure a mesma senha no banco e no DATABASE_URL; gerar o valor não altera o banco.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/eloscrm_dev?sslmode=disable
# Gere com: openssl rand -base64 32. Cole a saída inteira, sem espaços ou quebras de linha.
# Use um secret independente por ambiente; mantenha o valor entre reinícios e deploys.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3333
WEB_ORIGIN=http://localhost:3000
PORT=3333

R2_ENDPOINT=http://localhost:8333
# Credenciais locais do SeaweedFS. No R2, crie credenciais S3 no provedor e copie o
# Access Key ID e o Secret Access Key correspondentes; não gere esses valores com OpenSSL.
R2_ACCESS_KEY_ID=seaweedadmin
R2_SECRET_ACCESS_KEY=seaweedadmin
R2_PRIVATE_BUCKET_NAME=eloscrm-private

# Resend (transacional). Em branco = nada é enviado; o conteúdo do e-mail sai no stdout do server.
# EMAIL_FROM precisa de domínio verificado no Resend; o default usa o remetente de teste deles.
# Crie uma API key no Resend e copie o valor fornecido; não é um secret gerado localmente.
RESEND_API_KEY=
EMAIL_FROM=elosCRM <onboarding@resend.dev>

# uazapi (WhatsApp). Em branco = integração desligada; as rotas /v1/whatsapp respondem 503.
# PUBLIC_API_URL: URL pública desta API, para a uazapi entregar o webhook. Em dev precisa de túnel
# (ex: cloudflared tunnel --url http://localhost:3333); sem ele, sincronize pela tela.
UAZAPI_BASE_URL=https://free.uazapi.com
# Copie o token administrativo fornecido pela sua instalação/provedor uazapi.
# Se você administra o servidor, configure nele o mesmo token antes de usá-lo aqui.
UAZAPI_ADMIN_TOKEN=
# Gere com: openssl rand -hex 32. Formato obrigatório: 64 caracteres hexadecimais minúsculos.
# Gere uma chave própria para esta env. Preserve-a: trocar/perder a chave impede a leitura
# dos tokens uazapi e Meta Lead Ads já cifrados; rotação exige recifrar os dados existentes.
UAZAPI_TOKEN_ENCRYPTION_KEY=
PUBLIC_API_URL=

# Trilha de diagnóstico da integração em JSONL: o que sai para a uazapi, o que volta e o corpo cru
# dos webhooks. Vazio = desligado. Valores de token/segredo saem redigidos, mas as chaves ficam —
# é o nome do campo que revela o formato do envelope. Ligar só enquanto investiga.
# ATENÇÃO: o corpo gravado tem telefone e nome de contato. O arquivo é dado pessoal (LGPD): não
# compartilhe em issue/chat/ticket e apague ao terminar.
# UAZAPI_DEBUG_LOG=logs/uazapi.jsonl

# Fila das conversas de WhatsApp (BullMQ). Vazio = processamento inline no webhook, aceitável em
# dev e obrigatório de configurar em produção (senão o download de mídia trava a resposta).
# Se o Redis exigir senha, use a credencial configurada no serviço na URL de conexão.
REDIS_URL=redis://localhost:6379

# Meta Lead Ads. O token é do cliente (digitado na tela) e fica cifrado com UAZAPI_TOKEN_ENCRYPTION_KEY.
# A busca de leads roda a cada minuto quando há REDIS_URL; sem Redis, `pnpm meta:sync` ou o botão da tela.
# META_GRAPH_VERSION=v26.0

# WhatsApp oficial. Configuração compartilhada do app; ativos e tokens ficam no banco por conexão.
# Os IDs e o ACCESS_TOKEN do diagnóstico não são configuração global da operação.
META_WHATSAPP_APP_ID=
# Copie o App Secret do aplicativo na Meta. Ele é fornecido pela Meta, não gerado com OpenSSL.
# Deve pertencer ao mesmo app indicado em META_WHATSAPP_APP_ID.
META_WHATSAPP_APP_SECRET=
META_WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=
META_WHATSAPP_GRAPH_VERSION=v26.0
# Gere com: openssl rand -hex 32. Cole o mesmo valor no campo Verify Token do webhook na Meta.
# É um secret escolhido por você para verificar o webhook; não é App Secret nem Access Token.
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Gere novamente com: openssl rand -hex 32. Formato obrigatório: 64 caracteres hexadecimais minúsculos.
# Use uma chave diferente de UAZAPI_TOKEN_ENCRYPTION_KEY e do Verify Token.
# Preserve-a entre deploys: trocar/perder a chave impede a leitura dos tokens oficiais
# já cifrados; rotação exige recifrar os dados existentes.
META_WHATSAPP_TOKEN_ENCRYPTION_KEY=
WHATSAPP_JOURNAL_RETENTION_DAYS=30
WHATSAPP_COMMAND_RETENTION_DAYS=90

# Quanto tempo o log de auditoria fica (mínimo 30, máximo 3650). Com REDIS_URL a purga é agendada no
# boot, às 03:20; sem ela, rode `pnpm audit:purge` (dá para pendurar no cron do host).
AUDIT_RETENTION_DAYS=365
