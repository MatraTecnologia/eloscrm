# Copie para .env antes de rodar `pnpm dev`:
#   cp .env.example .env && pnpm db:push
# Os testes NÃO usam este arquivo — ver .env.test.example.
# Default: Postgres local (`docker compose up -d` na raiz do repo).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/eloscrm_dev?sslmode=disable
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3333
WEB_ORIGIN=http://localhost:3000
PORT=3333

R2_ENDPOINT=http://localhost:8333
R2_ACCESS_KEY_ID=seaweedadmin
R2_SECRET_ACCESS_KEY=seaweedadmin
R2_PRIVATE_BUCKET_NAME=eloscrm-private

# Resend (transacional). Em branco = nada é enviado; o conteúdo do e-mail sai no stdout do server.
# EMAIL_FROM precisa de domínio verificado no Resend; o default usa o remetente de teste deles.
RESEND_API_KEY=
EMAIL_FROM=elosCRM <onboarding@resend.dev>
